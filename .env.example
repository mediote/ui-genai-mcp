# ── Ambiente ────────────────────────────────────────────────────────────────
ENVIRONMENT=dev                 # dev | hml | prd
LOG_LEVEL=INFO

# ── Autenticação (Entra ID — app registration EXISTENTE) ────────────────────
# Em dev local sem Entra: AUTH_ENABLED=false (proibido em prd).
AUTH_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=         # em Azure: Container Apps secret / Key Vault reference
MCP_REQUIRED_SCOPE=access_as_user

# ── HTTP / transporte MCP ───────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost:*,127.0.0.1:*
ALLOWED_ORIGINS=
MCP_JSON_RESPONSE=true
MAX_REQUEST_BODY_BYTES=1048576
GRAPH_TIMEOUT_SECONDS=20

# ── Toolsets ────────────────────────────────────────────────────────────────
ENABLED_TOOLSETS=diagnostico
ALLOW_DIAGNOSTICS_IN_PRD=false

# ── Organograma (SharePoint) ────────────────────────────────────────────────
ORGANOGRAMA_SP_HOSTNAME=grupoultracloud.sharepoint.com
ORGANOGRAMA_SP_SITE_PATH=/sites/ug-base_conhecimento_genai
ORGANOGRAMA_SP_LIBRARY=base_RH_Organograma
ORGANOGRAMA_SP_FILE_NAME=Organograma.json
