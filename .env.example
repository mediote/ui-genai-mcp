# ── Ambiente ────────────────────────────────────────────────────────────────
ENVIRONMENT=dev                 # dev | hml | prd
LOG_LEVEL=INFO

# ── Autenticação (Entra ID — app registration EXISTENTE) ────────────────────
# Em dev local sem Entra: AUTH_ENABLED=false (proibido em prd).
AUTH_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=         # em Azure: Container Apps secret / Key Vault reference
MCP_REQUIRED_SCOPE=access_as_user

# ── HTTP / transporte MCP ───────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost:*,127.0.0.1:*
ALLOWED_ORIGINS=
MCP_JSON_RESPONSE=true
MAX_REQUEST_BODY_BYTES=1048576
GRAPH_TIMEOUT_SECONDS=20

# ── Toolsets ────────────────────────────────────────────────────────────────
ENABLED_TOOLSETS=diagnostico
ALLOW_DIAGNOSTICS_IN_PRD=false

# ── SharePoint (sonda de diagnóstico diag_sharepoint_probe) ─────────────────
# Opcional: só é usado pela sonda de diagnóstico. Preencha com um site/arquivo real.
SHAREPOINT_SP_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SP_SITE_PATH=/sites/exemplo
SHAREPOINT_SP_LIBRARY=Documentos
SHAREPOINT_SP_FILE_NAME=exemplo.json
