        "cidade": {
          "description": "Nome da localidade resolvida.",
          "title": "Cidade",
          "type": "string"
        },
        "condicao": {
          "description": "Descrição do tempo em pt-BR.",
          "title": "Condicao",
          "type": "string"
        },
        "latitude": {
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "title": "Longitude",
          "type": "number"
        },
        "observado_em": {
          "description": "Instante da observação (ISO 8601, fuso local).",
          "title": "Observado Em",
          "type": "string"
        },
        "pais": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
