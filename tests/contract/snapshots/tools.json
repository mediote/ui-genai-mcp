  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Retorna a previsão diária de uma cidade (mínima, máxima, probabilidade de chuva e descrição do tempo) para os próximos dias. Fonte: Open-Meteo (pública).",
    "inputSchema": {
      "properties": {
        "cidade": {
          "description": "Nome da cidade, ex.: 'São Paulo' ou 'Lisboa'.",
          "title": "Cidade",
          "type": "string"
        },
        "dias": {
          "default": 3,
          "description": "Quantidade de dias a prever (1 a 16).",
          "maximum": 16,
          "minimum": 1,
          "title": "Dias",
          "type": "integer"
        }
      },
      "required": [
        "cidade"
      ],
      "title": "clima_previsaoArguments",
      "type": "object"
    },
    "name": "clima_previsao",
    "outputSchema": {
      "$defs": {
        "DiaPrevisao": {
          "description": "Previsão consolidada de um dia.",
          "properties": {
            "condicao": {
              "description": "Descrição do tempo em pt-BR.",
              "title": "Condicao",
              "type": "string"
            },
            "data": {
              "description": "Data do dia (YYYY-MM-DD).",
              "title": "Data",
              "type": "string"
            },
            "prob_chuva_pct": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Probabilidade máxima de precipitação no dia (%).",
              "title": "Prob Chuva Pct"
            },
            "temp_max_c": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Temperatura máxima (°C).",
              "title": "Temp Max C"
            },
            "temp_min_c": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Temperatura mínima (°C).",
              "title": "Temp Min C"
            }
          },
          "required": [
            "data",
            "condicao"
          ],
          "title": "DiaPrevisao",
          "type": "object"
        }
      },
      "description": "Previsão diária de uma localidade.",
      "properties": {
        "cidade": {
          "description": "Nome da localidade resolvida.",
          "title": "Cidade",
          "type": "string"
        },
        "dias": {
          "description": "Previsão diária, em ordem cronológica.",
          "items": {
            "$ref": "#/$defs/DiaPrevisao"
          },
          "title": "Dias",
          "type": "array"
        },
        "latitude": {
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "title": "Longitude",
          "type": "number"
        },
        "pais": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "País da localidade.",
          "title": "Pais"
        }
      },
      "required": [
        "cidade",
        "latitude",
        "longitude",
        "dias"
      ],
      "title": "ClimaPrevisaoResult",
      "type": "object"
    },
    "title": "Clima: previsão dos próximos dias"
  },
