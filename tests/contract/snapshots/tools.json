          "title": "Pais"
        },
        "sensacao_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensação térmica em Celsius.",
          "title": "Sensacao C"
        },
        "temperatura_c": {
          "description": "Temperatura atual em graus Celsius.",
          "title": "Temperatura C",
          "type": "number"
        },
        "umidade_pct": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
